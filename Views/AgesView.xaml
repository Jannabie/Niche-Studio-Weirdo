<UserControl x:Class="NicheStudioWeirdo.Views.AgesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AGES Engine (rUGP) — Schwarzesmarken Hook Mode" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1"
                   Text="Patch-based translation workflow for Schwarzesmarken (殉教者たち). Uses the Chinese hook patch as a base — no .rio extraction needed."
                   Style="{StaticResource SubheaderStyle}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══ SECTION 1: How It Works ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP 1 — SETUP THE HOOK TOOLKIT" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,12"/>

                        <!-- Info banner -->
                        <Border Background="#0A1020" CornerRadius="0" Padding="14,12" Margin="0,0,0,16"
                                BorderThickness="1" BorderBrush="#1E2A4A">
                            <StackPanel>
                                <TextBlock Foreground="#6080C0" FontWeight="Bold" FontSize="12" Text="ℹ  HOW IT WORKS"/>
                                <TextBlock Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10"
                                           Text="Instead of extracting the encrypted .rio archive, this workflow uses a DLL hook that intercepts Japanese text at runtime and swaps it with your translation. The toolkit contains:"/>
                                
                                <Grid Margin="10,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#6080C0" FontSize="11" Text="• " Margin="0,0,6,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Foreground="#7A8AAA" FontSize="11" Text="winmm.dll + JLXH.dll — the hook loader (DLL hijacking)" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    
                                    <!-- Row 1 -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#6080C0" FontSize="11" Text="• " Margin="0,0,6,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#7A8AAA" FontSize="11" Text="FONTCHANGER.dll — handles font rendering for non-Japanese scripts" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    
                                    <!-- Row 2 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Foreground="#6080C0" FontSize="11" Text="• " Margin="0,0,6,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Foreground="#7A8AAA" FontSize="11" Text="シュヴァケン殉教者たち_tl.exe — the patched launcher" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    
                                    <!-- Row 3 -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Foreground="#6080C0" FontSize="11" Text="• " Margin="0,0,6,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Foreground="#7A8AAA" FontSize="11" Text="orgi.jlx — the full extracted Japanese script (16,957 lines)" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    
                                    <!-- Row 4 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Foreground="#6080C0" FontSize="11" Text="• " Margin="0,0,6,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Foreground="#7A8AAA" FontSize="11" Text="trans.jlx — the translation target file (edit this!)" Margin="0,0,0,0" TextWrapping="Wrap"/>
                                </Grid>
                                
                                <TextBlock Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"
                                           Text="Place all these files in the same folder as your Schwarzesmarken game, then run the _tl.exe."/>

                                <Border Background="#161208" CornerRadius="0" Padding="12,10" BorderThickness="1" BorderBrush="#3A2D12" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="#E0B050" FontSize="14" Text="💡" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="#D0A860" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center">
                                            For <Run Foreground="#FFD080" FontWeight="Bold">UI translation hooking</Run>, please contact me privately.<LineBreak/>
                                            I can assist anyone serious about translating this game. <Run Foreground="#FFD080" FontWeight="Bold">Discord: Obyyy#0999</Run>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A141A" CornerRadius="0" Padding="12,10" BorderThickness="1" BorderBrush="#122A3A">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="#50A0E0" FontSize="14" Text="🔧" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="#60B0F0" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center">
                                            <Run FontWeight="Bold">Note:</Run> Hook for choice translation is currently being implemented (via hooking as well) and will be added in a future update.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- GitHub download button -->
                        <TextBlock Text="DOWNLOAD HOOK TOOLKIT FROM GITHUB" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Text="Click the button below to open the GitHub repository containing all required hook files (winmm.dll, JLXH.dll, FONTCHANGER.dll, orgi.jlx, trans.jlx, launcher, font)."/>

                        <Button x:Name="OpenDriveBtn" Content="🔗  Open GitHub — Schwarzesmarken Hook"
                                Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left" Padding="18,10"
                                Click="OpenDrive_Click"/>

                        <TextBlock Foreground="#404860" FontSize="10" Margin="0,8,0,0"
                                   Text="https://github.com/Jannabie/Niche-Studio-Weirdo/tree/main/Schwarzesmarken%20Hook"/>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 2: JLX → JSON Parser ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP 2 — PARSE trans.jlx → JSON (for editing)" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,12"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"
                                   Text="Select the trans.jlx file (UTF-16LE, ':::::' delimited). This will convert it to a clean JSON array that you can edit with any text editor or AI translation tool."/>

                        <!-- Note -->
                        <Border Background="#0A140A" CornerRadius="0" Padding="14,10" Margin="0,0,0,16"
                                BorderThickness="1" BorderBrush="#1E3A1E">
                            <StackPanel>
                                <TextBlock Foreground="#60C060" FontWeight="Bold" FontSize="12" Text="📋  JSON FORMAT"/>
                                <TextBlock Foreground="#7A9A7A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Output is a UTF-8 JSON array: [{&quot;id&quot;: 0, &quot;jp&quot;: &quot;【ハンニバル】…&quot;, &quot;tl&quot;: &quot;【Hannibal】…&quot;}, …]. Edit the 'tl' fields with your Indonesian translation. The 'jp' field is for reference only."/>
                            </StackPanel>
                        </Border>

                        <!-- Input JLX files (orgi + trans) -->
                        <TextBlock Text="ORIGINAL SCRIPT (orgi.jlx)" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OrgiJlxTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                                     ToolTip="Path to orgi.jlx (the Japanese original)"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseOrgi_Click"/>
                        </Grid>

                        <TextBlock Text="TRANSLATION FILE (trans.jlx)" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TransJlxTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                                     ToolTip="Path to trans.jlx (the translation target)"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseTrans_Click"/>
                        </Grid>

                        <TextBlock Text="OUTPUT JSON FILE" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ParseOutTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                                     ToolTip="Where to save the output JSON file"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseParseOut_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Parse JLX → JSON" Style="{StaticResource ActionButtonGreen}"
                                    Click="ParseJlx_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 3: JSON → JLX Repack ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP 3 — REPACK JSON → trans.jlx (for game)" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,12"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"
                                   Text="After editing the 'tl' fields in your JSON file, repack it back into trans.jlx. Place the resulting file in the game folder alongside winmm.dll and run the launcher."/>

                        <!-- Note -->
                        <Border Background="#140A0A" CornerRadius="0" Padding="14,10" Margin="0,0,0,16"
                                BorderThickness="1" BorderBrush="#3A1E1E">
                            <StackPanel>
                                <TextBlock Foreground="#C06060" FontWeight="Bold" FontSize="12" Text="⚠  IMPORTANT"/>
                                <TextBlock Foreground="#9A7A7A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="The output trans.jlx must have the exact same number of entries as orgi.jlx (16,957 lines). Do not add or remove entries — only edit the 'tl' text values."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="TRANSLATED JSON FILE" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RepackJsonTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                                     ToolTip="Path to your translated JSON file"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseRepackJson_Click"/>
                        </Grid>

                        <TextBlock Text="OUTPUT trans.jlx PATH" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RepackOutTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                                     ToolTip="Where to save the new trans.jlx (e.g. same folder as your game)"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseRepackOut_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Repack JSON → trans.jlx" Style="{StaticResource ActionButton}"
                                    Click="RepackJson_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
