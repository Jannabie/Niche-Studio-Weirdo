<UserControl x:Class="NicheStudioWeirdo.Views.AgesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AGES Engine (rUGP 7.0)" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1"
                   Text="Extract and inspect .rio archives and script files from âge games (Schwarzesmarken / Muv-Luv series)."
                   Style="{StaticResource SubheaderStyle}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══ SECTION 1: ICI Inspector ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP 1 — INSPECT .ICI INDEX FILE" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Select the .ici file (e.g. muv_schB.rio.ici) to decrypt it and view the archive table of contents."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/>

                        <!-- Info note -->
                        <Border Background="#0A1020" CornerRadius="0" Padding="14,10" Margin="0,0,0,18"
                                BorderThickness="1" BorderBrush="#1E2A4A">
                            <StackPanel>
                                <TextBlock Foreground="#6080C0" FontWeight="Bold" FontSize="12" Text="ℹ  ENGINE INFO"/>
                                <TextBlock Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="AGES 7.0 uses a split archive format: one .ici index file + multiple .rio data files (muv_schB.rio, muv_schB.rio.002, muv_schB.rio.003). The ICI is encrypted with key 0xB29D5A0C and a custom key-rotation algorithm."/>
                            </StackPanel>
                        </Border>

                        <!-- ICI file picker -->
                        <TextBlock Text="SELECT .ICI FILE" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IciPathTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                                     ToolTip="Path to the .ici file (e.g. C:\game\muv_schB.rio.ici)"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseIci_Click"/>
                            <Button Grid.Column="2" Content="Inspect ICI" Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,0" Click="InspectIci_Click"/>
                        </Grid>

                        <!-- ICI result output -->
                        <TextBlock Text="ARCHIVE INFO" Style="{StaticResource LabelStyle}"/>
                        <Border Background="#0D0D10" BorderThickness="1" BorderBrush="#333" Padding="12" Margin="0,0,0,0">
                            <TextBox x:Name="IciResultTxt" IsReadOnly="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#9EC0FF" FontFamily="{StaticResource TerminalFont}"
                                     FontSize="11" MinHeight="80"
                                     Text="No ICI loaded yet. Browse and click Inspect ICI."/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 2: Script Extractor ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP 2 — EXTRACT SCRIPT TEXT FROM .RIO" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Select any .rio or .rio.002/.003 file to extract all readable Japanese/text strings from the AGES script (CRsa) objects inside."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/>

                        <!-- Note -->
                        <Border Background="#0A140A" CornerRadius="0" Padding="14,10" Margin="0,0,0,18"
                                BorderThickness="1" BorderBrush="#1E3A1E">
                            <StackPanel>
                                <TextBlock Foreground="#60C060" FontWeight="Bold" FontSize="12" Text="📜  SCRIPT FORMAT"/>
                                <TextBlock Foreground="#7A9A7A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="AGES scripts (CRsa class) store dialogue as Shift-JIS strings inside encrypted .rio data. The extractor scans the raw archive for Japanese text clusters. Output is a numbered .txt file you can use as a translation base."/>
                            </StackPanel>
                        </Border>

                        <!-- .rio input -->
                        <TextBlock Text="SELECT .RIO FILE (any part)" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RioPathTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                                     ToolTip="e.g. C:\game\muv_schB.rio or muv_schB.rio.003"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseRio_Click"/>
                        </Grid>

                        <!-- Output folder -->
                        <TextBlock Text="OUTPUT FOLDER (for extracted .txt)" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RioOutTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                                     ToolTip="Folder where the extracted script .txt will be saved"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseRioOut_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Extract Script Strings" Style="{StaticResource ActionButtonGreen}"
                                    Click="ExtractScript_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 3: Batch Inspect ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP 3 — BATCH EXTRACT (ALL PARTS)" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Select the folder containing all .rio files. The tool will scan and extract script strings from every part automatically."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/>

                        <TextBlock Text="GAME FOLDER (containing .rio files)" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BatchFolderTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseBatchFolder_Click"/>
                            <Button Grid.Column="2" Content="Batch Extract" Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,0" Click="BatchExtract_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
