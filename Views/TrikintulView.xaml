<UserControl x:Class="NicheStudioWeirdo.Views.TrikintulView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Lithium (3DS ATLUS Hacking Tools)" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Extract 3DS/CIA archives, rebuild RomFS, and translate Moonbeam MBM scripts."
                   Style="{StaticResource SubheaderStyle}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Background="{StaticResource BgDarkestBrush}" CornerRadius="0" Padding="20" BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}">
                <StackPanel>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- ARCHIVE DECRYPTION                                      -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <TextBlock Text="Archive Decryption (.3ds / .cia)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Border Background="#0A1020" CornerRadius="0" Padding="14,10" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#1E2A4A">
                        <StackPanel>
                            <TextBlock Foreground="#6080C0" FontWeight="Bold" FontSize="11" Text="💡  RECOMMENDATION"/>
                            <TextBlock Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="It is highly recommended to use .cia files instead of .3ds files. Decrypting and modifying .cia files ensures better compatibility for repackaging."/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#1A0500" CornerRadius="0" Padding="14,10" Margin="0,0,0,24" BorderThickness="1" BorderBrush="#6B1010">
                        <StackPanel>
                            <TextBlock Foreground="#FF4444" FontWeight="Bold" FontSize="11" Text="📖  IMPORTANT NOTE"/>
                            <TextBlock Foreground="#CC8888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="If your game is already decrypted, you can SKIP this Decrypt step and go straight to Archive Extraction!"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputDecrypt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select encrypted .3ds or .cia file..." ToolTip="Output will be saved as '-decrypted' next to original file."/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseDecrypt_Click"/>
                        <Button Grid.Column="2" Content="Decrypt Archive" Style="{StaticResource ActionButtonGreen}" Margin="8,0,0,0" Click="DecryptArchive_Click"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- ARCHIVE EXTRACTION                                      -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <TextBlock Text="Archive Extraction (.3ds / .cia)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputArchive" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select decrypted .3ds or .cia file..." ToolTip="Creates a '_Unpacked' folder with the game's contents."/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseArchive_Click"/>
                        <Button Grid.Column="2" Content="Extract Archive" Style="{StaticResource ActionButtonGreen}" Margin="8,0,0,0" Click="ExtractArchive_Click"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- ARCHIVE REPACK                                          -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <TextBlock Text="Archive Repack (_Unpacked Folder)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RepackSource" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select _Unpacked folder..." ToolTip="Creates an '_Edited' archive."/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseRepackSource_Click"/>
                        <Button Grid.Column="2" Content="Repack CIA" Style="{StaticResource ActionButtonGreen}" Margin="8,0,0,0" Click="RepackCIA_Click"/>
                        <Button Grid.Column="3" Content="Repack 3DS" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="Repack3DS_Click"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- ROMFS EXTRACT & REBUILD                                 -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <TextBlock Text="RomFS Tools" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Border Background="#0A1020" CornerRadius="0" Padding="14,10" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#1E2A4A">
                        <StackPanel>
                            <TextBlock Foreground="#6080C0" FontWeight="Bold" FontSize="11" Text="💡  RECOMMENDATION"/>
                            <TextBlock Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="If you already got the ExtractedRomFS folder from the Archive Extraction step, you can SKIP this RomFS Extract step!"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RomFsPath" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select RomFS .bin to extract or folder to rebuild..."/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseRomFs_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
                        <Button Content="Extract RomFS" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="ExtractRomFs_Click"/>
                        <Button Content="Build RomFS" Style="{StaticResource ActionButtonGreen}" Click="BuildRomFs_Click"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- MOONBEAM SCRIPT TRANSLATOR                              -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <TextBlock Text="Moonbeam Script Tools (.mbm)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MoonbeamExportPath" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select .mbm file or folder to export..."/>
                        <Button Grid.Column="1" Content="File" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseMoonbeamExportFile_Click"/>
                        <Button Grid.Column="2" Content="Folder" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseMoonbeamExportFolder_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                        <Button Content="Export to XML" Style="{StaticResource ActionButton}" Click="ExportMbm_Click"/>
                    </StackPanel>

                    <!-- Import to MBM -->
                    <TextBlock Text="Import XML to MBM" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MoonbeamImportPath" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select .xml file or folder to import..."/>
                        <Button Grid.Column="1" Content="File" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseMoonbeamImportFile_Click"/>
                        <Button Grid.Column="2" Content="Folder" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseMoonbeamImportFolder_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
                        <Button Content="Import to MBM" Style="{StaticResource ActionButtonGreen}" Click="ImportMbm_Click"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- STRANGE JOURNEY REDUX FBIN TOOLS                      -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Border Background="#1A0500" CornerRadius="0" Padding="14,10" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#6B1010">
                        <StackPanel>
                            <TextBlock Foreground="#FF4444" FontWeight="Bold" FontSize="11" Text="📖  IMPORTANT NOTE"/>
                            <TextBlock Foreground="#CC8888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Select the original .bin or .mbm file. 'Deep Extract' will automatically unpack ALL layers (FBIN → TBB1 → MBM) in one click. After translating the .mbm XML files using Moonbeam above, click 'Deep Repack' to re-bundle everything back into the original file."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Strange Journey Redux Archive Tools" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SjrDeepPath" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select .bin or .mbm file..."/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseSjrDeepFile_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
                        <Button Content="Deep Extract (All Layers)" Style="{StaticResource ActionButton}" Click="DeepExtract_Click" Margin="0,0,8,0"/>
                        <Button Content="Deep Repack (All Layers)" Style="{StaticResource ActionButtonGreen}" Click="DeepRepack_Click"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- IMAGE TOOLS                                             -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <TextBlock Text="Image Tools" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                    <!-- STEX to PNG -->
                    <TextBlock Text="Convert STEX to PNG" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="StexInputPath" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select STEX file..."/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseStexInput_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                        <Button Content="STEX -> PNG" Style="{StaticResource ActionButton}" Click="StexToPng_Click"/>
                    </StackPanel>

                    <!-- PNG to STEX -->
                    <TextBlock Text="Convert PNG to STEX" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PngInputPath" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select PNG file..."/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowsePngInput_Click"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RefStexPath" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select Reference STEX file..."/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseRefStex_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
                        <Button Content="PNG -> STEX" Style="{StaticResource ActionButtonGreen}" Click="PngToStex_Click"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- VIDEO TOOLS                                             -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <TextBlock Text="Video Tools (.moflex)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Text="Mobiclip video tools for 3DS fan-translation. Extract = High Quality MP4. Then edit subtitle/video, then use the Official Mobiclip Multicore Encoder to encode back to Moflex."/>

                    <!-- Extract to MP4 -->
                    <TextBlock Text="EXTRACT — Moflex → MP4" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MoflexInputPath" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select .moflex or .mods file..."/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseMoflexInput_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                        <Button Content="Extract to MP4" Style="{StaticResource ActionButton}" Click="ExtractToMp4_Click"/>
                    </StackPanel>

                    <!-- Encode to Moflex (Official Encoder Bypass) -->
                    <TextBlock Text="ENCODE — MP4 → Moflex" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Opens the official Mobiclip Multicore Encoder (via RunAsDate date bypass)."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <Button Content="Open Official Mobiclip Encoder" Style="{StaticResource ActionButtonGreen}" Click="EncodeToMoflex_Click"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                    <!-- Kuriimu2 GitHub download button -->
                    <TextBlock Text="KURIIMU2 ARCHITECTURE TOOLKIT" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Text="For a more complete architecture recommendation or for games other than SMT IV or Atlus 3DS, you can use Kuriimu2."/>

                    <Button x:Name="OpenKuriimuGithubBtn" Content="🔗  Open GitHub — Kuriimu2"
                            Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Left" Padding="18,10" Margin="0,0,0,24"
                            Click="OpenKuriimuGithub_Click"/>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
