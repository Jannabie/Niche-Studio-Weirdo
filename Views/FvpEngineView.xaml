<UserControl x:Class="NicheStudioWeirdo.Views.FvpEngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="FVP Engine" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Extract and repack .bin archives, decompile .hcb scripts, and convert NVSG image files."
                   Style="{StaticResource SubheaderStyle}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══ FVP LOADER NOTICE ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="FVP LOADER — RENDERING FIX" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,12"/>

                        <!-- Info banner -->
                        <Border Background="#0A1020" CornerRadius="0" Padding="14,12" Margin="0,0,0,16"
                                BorderThickness="1" BorderBrush="#1E2A4A">
                            <StackPanel>
                                <TextBlock Foreground="#6080C0" FontWeight="Bold" FontSize="12" Text="⚙  GAME RENDERING ISSUES?"/>
                                <TextBlock Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10"
                                           Text="If you experience rendering problems or visual glitches when running the game (e.g. black screen, missing graphics, or broken visuals after patching), use the FVP Loader. It is a custom loader that fixes known rendering compatibility issues for FVP Engine titles."/>
                            </StackPanel>
                        </Border>

                        <!-- GitHub button -->
                        <TextBlock Text="DOWNLOAD FVP LOADER FROM GITHUB" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Text="Click the button below to open the FVP Loader repository and download the required files."/>

                        <Button x:Name="OpenFvpLoaderBtn" Content="🔗  Open GitHub — FVP Loader"
                                Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left" Padding="18,10"
                                Click="OpenFvpLoader_Click"/>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 1: BIN Archive ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="BIN ARCHIVE — EXTRACT &amp; REPACK" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Extract files from a .bin archive, or pack a folder back into a .bin archive."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/>

                        <!-- Important Note -->
                        <Border Background="#1A0A0A" CornerRadius="0" Padding="14,10" Margin="0,0,0,24" BorderThickness="1" BorderBrush="#3A1E1E">
                            <StackPanel>
                                <TextBlock Foreground="#FF6060" FontWeight="Bold" FontSize="12" Text="📖  IMPORTANT NOTE"/>
                                <TextBlock Text="When packing, make sure the folder DOES NOT contain any files other than those unpacked from the original archive! FVP expects a fixed number of files." 
                                           Foreground="#CC7A7A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Extract -->
                        <TextBlock Text="EXTRACT: SELECT .BIN FILE" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BinInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseBinInput_Click"/>
                            <Button Grid.Column="2" Content="Extract BIN" Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,0" Click="BinExtract_Click"/>
                        </Grid>

                        <!-- Repack -->
                        <TextBlock Text="REPACK: SELECT FOLDER TO PACK" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BinRepackFolderTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseBinRepackFolder_Click"/>
                            <Button Grid.Column="2" Content="Repack to .BIN" Style="{StaticResource ActionButtonGreen}"
                                    Margin="8,0,0,0" Click="BinRepack_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 2: HCB Script ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="HCB SCRIPT — DECOMPILE &amp; COMPILE" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Extract strings.txt + script.dat from an .hcb file, and compile them back."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/>

                        <!-- Decompile -->
                        <TextBlock Text="DECOMPILE: SELECT .HCB FILE" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HcbDecompileTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseHcbDecompile_Click"/>
                            <Button Grid.Column="2" Content="Decompile HCB" Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,0" Click="HcbDecompile_Click"/>
                        </Grid>

                        <!-- Compile -->
                        <TextBlock Text="COMPILE: SELECT EDITED FOLDER (contains strings.txt)" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HcbCompileFolderTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseHcbCompileFolder_Click"/>
                            <Button Grid.Column="2" Content="Compile to .HCB" Style="{StaticResource ActionButtonGreen}"
                                    Margin="8,0,0,0" Click="HcbCompile_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 3: NVSG Image Converter ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="NVSG IMAGE — DECODE &amp; ENCODE" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Convert NVSG / .hzc images to .png for editing, and back to NVSG."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/>

                        <!-- Decode -->
                        <TextBlock Text="DECODE: SELECT NVSG / .HZC FILE" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NvsgDecodeTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseNvsgDecode_Click"/>
                            <Button Grid.Column="2" Content="Decode to PNG" Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,0" Click="NvsgDecode_Click"/>
                        </Grid>

                        <!-- Encode -->
                        <TextBlock Text="ENCODE: SELECT EDITED .PNG FILE" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NvsgEncodeTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseNvsgEncode_Click"/>
                            <Button Grid.Column="2" Content="Encode to NVSG" Style="{StaticResource ActionButtonGreen}"
                                    Margin="8,0,0,0" Click="NvsgEncode_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
