<UserControl x:Class="NicheStudioWeirdo.Views.YurisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="YU-RIS Engine (RxYuris)" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Patch YPF archives and decrypt YSTB script files for YU-RIS engine games."
                   Style="{StaticResource SubheaderStyle}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══ SECTION 1: YPF Extract & Repack ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="YPF ARCHIVE — EXTRACT &amp; REPACK" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Extract files from a .ypf archive, or pack a folder into a new .ypf archive."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/>

                        <!-- Important Note -->
                        <Border Background="#0A1A0A" CornerRadius="0" Padding="14,10" Margin="0,0,0,24" BorderThickness="1" BorderBrush="#1E3A1E">
                            <StackPanel>
                                <TextBlock Foreground="#60C060" FontWeight="Bold" FontSize="12" Text="📖  IMPORTANT NOTE"/>
                                <TextBlock Text="Many games prioritize loading loose files. You might not need to repack — just put the extracted folder in the game directory!" 
                                           Foreground="#7A9A7A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Extract -->
                        <TextBlock Text="EXTRACT: SELECT .YPF FILE" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="YpfInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseYpfInput_Click"/>
                            <Button Grid.Column="2" Content="Extract YPF" Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,0" Click="YpfExtract_Click"/>
                        </Grid>

                        <!-- Repack -->
                        <TextBlock Text="REPACK: SELECT FOLDER TO PACK" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="YpfRepackFolderTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseYpfRepackFolder_Click"/>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                            <CheckBox x:Name="YpfUseCrc32Chk" Content="Use CRC32 Hash" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0" ToolTip="Check this if the repacked YPF doesn't load in-game (fixes duplicate [] error)"/>
                            <TextBlock Text="Engine Version:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                            <TextBox x:Name="YpfEngineVersionTxt" Width="60" Text="0.479" Style="{StaticResource TextBoxStyle}" Margin="0,0,12,0"/>
                            <Button Content="Repack to .YPF" Style="{StaticResource ActionButtonGreen}" Click="YpfRepack_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 2: YBN Script Workflow ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="20" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="YBN SCRIPT — ONE-CLICK WORKFLOW" Style="{StaticResource LabelStyle}"
                                   FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Automated workflow to decrypt scripts, extract text, and repack them back."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/>

                        <!-- Important Note -->
                        <Border Background="#0A1A0A" CornerRadius="0" Padding="14,10" Margin="0,0,0,24" BorderThickness="1" BorderBrush="#1E3A1E">
                            <StackPanel>
                                <TextBlock Foreground="#60C060" FontWeight="Bold" FontSize="12" Text="📖  IMPORTANT NOTE"/>
                                <TextBlock Text="Not all .ybn files contain dialogue. Many are just system code/logic. If you have 300+ .ybn files but only ~150 extract to JSON, that is completely normal!" 
                                           Foreground="#7A9A7A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Folder Selection -->
                        <TextBlock Text="SELECT FOLDER CONTAINING .YBN FILES" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="YbnFolderTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}"
                                    Margin="8,0,0,0" Click="BrowseYbnFolder_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Decrypt &amp; Extract Text" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="YbnDecryptExtract_Click"/>
                            <Button Content="Insert Text &amp; Encrypt" Style="{StaticResource ActionButtonGreen}" Click="YbnInsertEncrypt_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
