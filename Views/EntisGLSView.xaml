<UserControl x:Class="NicheStudioWeirdo.Views.EntisGLSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="EntisGLS" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Unpack .noa archives, extract and inject SRCXML script translations." Style="{StaticResource SubheaderStyle}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Info Banner -->
                <Border Background="#0A0D1A" CornerRadius="0" Padding="14,10" Margin="0,0,0,20"
                        BorderThickness="1" BorderBrush="#1E253A">
                    <StackPanel>
                        <TextBlock Foreground="#6090FF" FontWeight="Bold" FontSize="12"
                                   Text="💡  UI TRANSLATION SUPPORT"/>
                        <TextBlock Foreground="#7A8AAA" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="When unpacking NOA archives, .eri image files from the EntisGLS engine are automatically parsed into standard .png formats. This allows translators to easily view, edit, and translate UI elements without needing specialized image converters."/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BgDarkestBrush}" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}">
                    <StackPanel>

                        <!-- UNPACK -->
                        <TextBlock Text="UNPACK  —  .noa Archive → Folder" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>

                        <TextBlock Text="INPUT .NOA FILE" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="InputNoaFile" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseInputNoa_Click"/>
                        </Grid>

                        <Button Content="Unpack .NOA → Folder" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Right" Padding="20,8" Margin="0,0,0,16" Click="UnpackNoa_Click"/>

                        <!-- NOA Warning -->
                        <Border Background="#1A0A0A" CornerRadius="0" Padding="14,10" Margin="0,0,0,28"
                                BorderThickness="1" BorderBrush="#3A1E1E">
                            <StackPanel>
                                <TextBlock Foreground="#FF6060" FontWeight="Bold" FontSize="12" Text="⛔  WARNING — ALWAYS KEEP A BACKUP OF YOUR ORIGINAL .NOA"/>
                                <TextBlock Foreground="#AA7A7A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Repacked .noa files (output from the Pack step) CANNOT be unpacked again using this tool. The internal format differs from the original game .noa. Always keep a backup of the original .noa file before making any modifications."/>
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>

                        <!-- PARSE / INJECT -->
                        <TextBlock Text="PARSE / INJECT  —  SRCXML ↔ TXT" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock Text="Parse extracts all dialogue from .srcxml files into editable .txt files. Inject writes the translated .txt text back into the original .srcxml files." Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <TextBlock Text="SRCXML FOLDER" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SrcxmlFolder" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseSrcxmlFolder_Click"/>
                        </Grid>

                        <TextBlock Text="TXT TRANSLATION FOLDER" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFolder" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseTxtFolder_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Parse  (SRCXML → TXT)" Style="{StaticResource ActionButtonGreen}" Padding="0,8" Click="ParseSrcxml_Click"/>
                            <Button Grid.Column="2" Content="Inject  (TXT → SRCXML)" Style="{StaticResource ActionButtonGreen}" Padding="0,8" Click="InjectSrcxml_Click"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>

                        <!-- PACK -->
                        <TextBlock Text="REPACK  —  Folder → .noa Archive" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>

                        <TextBlock Text="SOURCE FOLDER (TRANSLATED SRCXML)" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="PackSourceFolder" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowsePackSource_Click"/>
                        </Grid>

                        <Button Content="Repack → .NOA" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Right" Padding="20,8" Click="PackNoa_Click"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
