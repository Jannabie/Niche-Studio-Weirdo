<UserControl x:Class="NicheStudioWeirdo.Views.QlieEngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QLIE Engine — Script Override Mode" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1"
                   Text="Translation workflow for QLIE games (e.g. Bishoujo Mangekyou). Uses VNTextPatch to parse .s scripts to JSON and inject translations back. No repacking needed."
                   Style="{StaticResource SubheaderStyle}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══ SECTION 1: Unpack ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="24" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP 1 — UNPACK .PACK ARCHIVES" Style="{StaticResource LabelStyle}"
                                   Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>
                        <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,16"/>

                        <Border Background="#0A1020" Padding="14,12" Margin="0,0,0,8"
                                BorderThickness="1" BorderBrush="#1E2A4A">
                            <StackPanel>
                                <TextBlock Foreground="#6080C0" FontWeight="Bold" FontSize="12" Text="ℹ  HOW TO UNPACK"/>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Use an external extractor like GARbro to unpack the script archives. In Bishoujo Mangekyou, scripts are typically in data1.pack or data2.pack. Extract to a folder to get the loose .s script files."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 2: Parse to JSON ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="24" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP 2 — PARSE SCRIPTS → JSON" Style="{StaticResource LabelStyle}"
                                   Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>
                        <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,16"/>

                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Text="Select the folder containing extracted .s scripts. VNTextPatch will compile all translatable text into a single JSON file."/>

                        <TextBlock Text="INPUT .S SCRIPTS FOLDER" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputScriptsFolderBox" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0"
                                    Click="BrowseInputScriptsBtn_Click"/>
                        </Grid>

                        <TextBlock Text="OUTPUT JSON FILE" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputJsonBox" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0"
                                    Click="BrowseOutputJsonBtn_Click"/>
                        </Grid>

                        <Button x:Name="ParseScriptsBtn" Content="Parse Scripts → JSON"
                                Style="{StaticResource ActionButtonGreen}"
                                HorizontalAlignment="Right" Padding="20,8"
                                Click="ParseScriptsBtn_Click"/>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 3: Repack Scripts ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="24" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP 3 — INJECT JSON → .S SCRIPTS" Style="{StaticResource LabelStyle}"
                                   Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>
                        <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,16"/>

                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Text="Select the translated JSON, the original .s folder (required as template), and an output folder for the translated .s files."/>

                        <TextBlock Text="TRANSLATED JSON FILE" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TranslatedJsonBox" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0"
                                    Click="BrowseTranslatedJsonBtn_Click"/>
                        </Grid>

                        <TextBlock Text="OUTPUT .S SCRIPTS FOLDER" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputScriptsFolderBox" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                            <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0"
                                    Click="BrowseOutputScriptsBtn_Click"/>
                        </Grid>

                        <Button x:Name="RepackScriptsBtn" Content="Inject JSON → .S Scripts"
                                Style="{StaticResource ActionButtonGreen}"
                                HorizontalAlignment="Right" Padding="20,8"
                                Click="RepackScriptsBtn_Click"/>
                    </StackPanel>
                </Border>

                <!-- ═══ SECTION 4: Install ═══ -->
                <Border Background="{StaticResource BgDarkestBrush}" Padding="24" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STEP 4 — INSTALL &amp; PLAY" Style="{StaticResource LabelStyle}"
                                   Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>
                        <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,16"/>

                        <Border Background="#161208" Padding="14,12" BorderThickness="1" BorderBrush="#3A2D12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#E0B050" FontSize="14" Text="💡" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Foreground="#D0A860" FontSize="11" TextWrapping="Wrap">
                                    <Run FontWeight="Bold">No repacking needed!</Run><LineBreak/>
                                    QLIE natively prioritizes loose files. Simply copy the translated .s files (preserving folder structure) directly into the game's <Run Foreground="#FFD080" FontWeight="Bold">GameData</Run> folder. The engine reads loose files before .pack archives.
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
