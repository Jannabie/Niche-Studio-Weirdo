<UserControl x:Class="NicheStudioWeirdo.Views.N2SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="N2System / Nitro+ (NPA)" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Extract and repack .npa archives for older Nitro+ and CHiRAL games. Select your game title from the list below." Style="{StaticResource SubheaderStyle}"/>

        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource BgDarkestBrush}" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}">
                <StackPanel>

                    <!-- GAME SELECTION -->
                    <TextBlock Text="SELECT YOUR GAME" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock Text="If your game is not in the list, try '[No Encryption]'. Versions marked '(Trial)', '(After Disk)', etc. are special editions." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="11"/>
                    <!-- The Tag stores the internal nipa GameID that gets passed to the CLI -->
                    <ComboBox x:Name="GameProfileCombo" Margin="0,0,0,24" SelectedIndex="0">
                        <ComboBoxItem Content="[No Encryption] — Unknown / Other Game"          Tag=""/>
                        <ComboBoxItem Content="Chaos;Head"                                       Tag="ChaosHead"/>
                        <ComboBoxItem Content="Chaos;Head (Trial version)"                       Tag="ChaosHeadTr1"/>
                        <ComboBoxItem Content="Chaos;Head (Trial version 2)"                     Tag="ChaosHeadTr2"/>
                        <ComboBoxItem Content="Full Metal Daemon Muramasa"                       Tag="Muramasa"/>
                        <ComboBoxItem Content="Full Metal Daemon Muramasa (Trial)"               Tag="MuramasaTr"/>
                        <ComboBoxItem Content="Full Metal Daemon Muramasa (After Disk)"          Tag="MuramasaAD"/>
                        <ComboBoxItem Content="Full Metal Daemon Muramasa: Shokuzai-hen"         Tag="MuramasaSS"/>
                        <ComboBoxItem Content="Sumaga"                                           Tag="Sumaga"/>
                        <ComboBoxItem Content="Sumaga (3rd Party)"                              Tag="Sumaga3P"/>
                        <ComboBoxItem Content="Sumaga SP"                                        Tag="SumagaSP"/>
                        <ComboBoxItem Content="Django"                                           Tag="Django"/>
                        <ComboBoxItem Content="Django (Trial)"                                   Tag="DjangoTr"/>
                        <ComboBoxItem Content="Lamento -Beyond the Void-"                        Tag="Lamento"/>
                        <ComboBoxItem Content="Lamento -Beyond the Void- (Trial)"                Tag="LamentoTr"/>
                        <ComboBoxItem Content="sweet pool"                                       Tag="sweetpool"/>
                        <ComboBoxItem Content="Demonbane"                                        Tag="Demonbane"/>
                        <ComboBoxItem Content="Axanael"                                          Tag="Axanael"/>
                        <ComboBoxItem Content="Kikokugai"                                        Tag="Kikokugai"/>
                        <ComboBoxItem Content="Super Sonico -The Animation- (SoniComi)"          Tag="Sonicomi"/>
                        <ComboBoxItem Content="Super Sonico -The Animation- (SoniComi, Trial 2)" Tag="SonicomiTr2"/>
                        <ComboBoxItem Content="Phenomeno: Lost X"                               Tag="LostX"/>
                        <ComboBoxItem Content="Phenomeno: Lost X (Trailer)"                     Tag="LostXTrailer"/>
                        <ComboBoxItem Content="DRAMAtical Murder"                                Tag="DRAMAticalMurder"/>
                        <ComboBoxItem Content="DRAMAtical Murder re:connect"                     Tag="DRAMAticalMurderRC"/>
                        <ComboBoxItem Content="Kimi to Kanojo to Kanojo no Koi (Totono)"         Tag="Totono"/>
                    </ComboBox>

                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>

                    <!-- EXTRACT -->
                    <TextBlock Text="STEP 1 — EXTRACT: Archive.npa → Folder" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>

                    <TextBlock Text="INPUT .NPA FILE" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ExtractInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseExtractInput_Click"/>
                    </Grid>

                    <TextBlock Text="The extracted folder will be created next to your .npa file automatically." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <Button Content="Extract → Folder" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Right" Padding="20,8" Margin="0,0,0,28" Click="Extract_Click"/>

                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>

                    <!-- REPACK -->
                    <TextBlock Text="STEP 2 — REPACK: Folder → Archive.npa" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>

                    <TextBlock Text="INPUT FOLDER (extracted files)" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RepackInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseRepackInput_Click"/>
                    </Grid>

                    <TextBlock Text="OUTPUT .NPA (where to save)" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RepackOutputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseRepackOutput_Click"/>
                    </Grid>

                    <CheckBox x:Name="ChkCompress" Content="Enable compression (only for non-image archives)" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,6"
                              ToolTip="NEVER check this for CG/image folders. It will corrupt the game graphics."/>
                    <Border Background="#1A0500" CornerRadius="0" Padding="14,10" Margin="0,4,0,16" BorderThickness="1" BorderBrush="#6B1010">
                        <StackPanel>
                            <TextBlock Foreground="#FF4444" FontWeight="Bold" FontSize="11" Text="📖  COMPRESSION NOTE"/>
                            <TextBlock Text="Do NOT compress CG folders — only use this for script/data files." Foreground="#CC8888" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Repack → .NPA" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Right" Padding="20,8" Margin="0,0,0,24" Click="Repack_Click"/>

                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>

                    <!-- TRANSLATION TIPS + WARNINGS -->
                    <Border Background="#111" CornerRadius="0" Padding="16" Margin="0,0,0,0" BorderBrush="#333" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📋  TRANSLATION TIPS" Foreground="#599EAC" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                            <TextBlock Text="✅  When extraction is done, the console will print a file list with garbled characters." Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="    This is NORMAL and means success — the filenames are in Japanese and display as symbols." Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap" FontStyle="Italic"/>

                            <TextBlock Text="🔡  ESCAPE CHARACTERS — Special Punctuation" Foreground="#B08B50" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4">
                                <Run>The N2System engine cannot read certain punctuation symbols directly.</Run>
                                <LineBreak/>
                                <Run>You must prefix them with &amp; (ampersand) to escape them properly.</Run>
                            </TextBlock>
                            <Border Background="#1a1a1a" CornerRadius="0" Padding="10,8" Margin="0,4,0,4" BorderBrush="#333" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="WRONG:   I want to eat." Foreground="#A06060" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Text="CORRECT: I want to eat&amp;." Foreground="#60A060" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text='CORRECT: Wait&amp;, I&apos;m not ready&amp;!' Foreground="#60A060" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,4" FontSize="11">
                                <Run>Apply this rule to: period (&amp;.), comma (&amp;,), exclamation (&amp;!), question mark (&amp;?), ellipsis (&amp;…)</Run>
                            </TextBlock>

                            <Border Height="1" Background="#222" Margin="0,10,0,10"/>

                            <Border Background="#1A0500" CornerRadius="0" Padding="14,10" Margin="0,0,0,0"
                                    BorderThickness="1" BorderBrush="#6B1010">
                                <StackPanel>
                                    <TextBlock Foreground="#FF4444" FontWeight="Bold" FontSize="12" Text="📖  IMPORTANT NOTES"/>
                                    <TextBlock Text="• DO NOT compress a CG folder when repacking — it will break the N2System engine." Foreground="#CC8888" FontSize="11" Margin="0,4,0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="• If you want to edit UI graphics, you must use Photoshop to prevent technical errors." Foreground="#CC8888" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
