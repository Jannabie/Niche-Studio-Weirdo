<UserControl x:Class="NicheStudioWeirdo.Views.MalieKitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Malie" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Decrypt .dat/.lib, convert MGF graphics, export/inject Names and Dialog separately." Style="{StaticResource SubheaderStyle}"/>

        <StackPanel Grid.Row="2">
            <!-- Tab Buttons -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TabArchive" Content="Archive (.dat / .lib)" Style="{StaticResource BrowseButton}" Click="SwitchTab_Click" Tag="ARCHIVE" Margin="0,0,4,0"/>
                <Button x:Name="TabScript" Content="Script Translation" Style="{StaticResource BrowseButton}" Click="SwitchTab_Click" Tag="SCRIPT" Margin="0,0,4,0"/>
                <Button x:Name="TabGfx" Content="Graphics (MGF)" Style="{StaticResource BrowseButton}" Click="SwitchTab_Click" Tag="GFX"/>
            </StackPanel>

            <!-- Archive Panel -->
            <Border x:Name="PanelArchive" Background="{StaticResource BgDarkestBrush}" CornerRadius="0" Padding="20" BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}">
                <StackPanel>
                    <!-- DX Version Notice -->
                    <Border Background="#0A1020" CornerRadius="0" Padding="14,12" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#1E2A4A">
                        <StackPanel>
                            <TextBlock Foreground="#6080C0" FontWeight="Bold" FontSize="12" Text="⚙️  DIES IRAE DX (MANGAGAMER) SUPPORT"/>
                            <TextBlock Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="This tool supports extracting files from the Dies irae DX version by MangaGamer. However, the script parser is not yet fully implemented for the DX version. Please ignore any traceback calls or warnings during extraction, as they are expected. If the tool appears stuck, please be patient as the process can take a long time to complete."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DECRYPT ARCHIVE (.DAT OR .LIB)" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="DecryptArchiveTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="Browse File" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseDecryptArchive_Click"/>
                    </Grid>
                    <Button Content="Decrypt Archive" Style="{StaticResource BrowseButton}" Margin="0,0,0,20" HorizontalAlignment="Left" Click="Decrypt_Click"/>

                    <!-- Red Warning: Rename / Override After Repack -->
                    <Border Background="#1A0500" CornerRadius="0" Padding="14,12" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#6B1010">
                        <StackPanel>
                            <TextBlock Foreground="#FF4444" FontWeight="Bold" FontSize="12" Text="⚠  RE-ENCRYPT: IMPORTANT — READ BEFORE USE"/>
                            <TextBlock Foreground="#CC8888" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="After re-encrypting, the tool will produce a NEW file (e.g. data3_repack.dat). You must MANUALLY RENAME or REPLACE the original game file with this output."/>
                            <TextBlock Foreground="#CC8888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Example: If the game uses data.dat through data4.dat, rename your output to data5.dat and place it in the game folder. The game engine will automatically load it last, overriding earlier archives."/>
                            <TextBlock Foreground="#CC8888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" FontStyle="Italic"
                                       Text="Tip: Alternatively, you can directly overwrite the original .dat file with your repacked output if you no longer need the original."/>
                            <TextBlock Foreground="#AA6666" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="Bold"
                                       Text="About File Size Difference:"/>
                            <TextBlock Foreground="#CC8888" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="It is completely normal if the repacked .dat file is smaller than the original. Not all files inside the archive are extracted — only the ones that are relevant and parseable are processed. The tool has been written to extract as much useful content as possible, but some engine-internal or unsupported entries are intentionally skipped. This will not break the game as long as the patched files are correctly included."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RE-ENCRYPT ARCHIVE (EXTRACTED FOLDER)" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="Select the root extracted folder (e.g. 'data3'), not a subfolder inside it." Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="EncryptArchiveTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="Browse Folder" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseEncryptArchive_Click"/>
                    </Grid>

                    <TextBlock Text="METADATA JSON (OPTIONAL — AUTO-DETECTED IF EMPTY)" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="Leave blank to auto-detect. Browse manually if your JSON file is in a non-standard location." Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="MetaJsonTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" IsReadOnly="False"/>
                        <Button Grid.Column="1" Content="Browse JSON" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseMetaJson_Click"/>
                    </Grid>
                    <Button Content="Re-encrypt Archive" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Left" Click="Encrypt_Click"/>
                </StackPanel>
            </Border>


            <!-- Script Panel (hidden) -->
            <Border x:Name="PanelScript" Background="{StaticResource BgDarkestBrush}" CornerRadius="0" Padding="20" BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="#0A1020" CornerRadius="0" Padding="14,12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#1E2A4A">
                        <StackPanel>
                            <TextBlock Text="⚙️  IMPORTANT: EXPORT &amp; PATCH ORDER" FontWeight="Bold" Foreground="#6080C0" Margin="0,0,0,8" FontSize="12"/>
                            <TextBlock Text="Character Names and Dialog must be patched in separate passes. You MUST Export Names FIRST before exporting Dialog." Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Note: If you export Dialog and patch it without names, it will fail because it needs string names." Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1A0500" CornerRadius="0" Padding="14,12" Margin="0,0,0,20" BorderThickness="1" BorderBrush="#6B1010">
                        <StackPanel>
                            <TextBlock Foreground="#FF4444" FontWeight="Bold" FontSize="11" Text="📖  IMPORTANT NOTE"/>
                            <TextBlock Foreground="#CC8888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Dies irae DX (MangaGamer version) is NOT yet supported for script translation in this tool. Script export and injection for the DX version has not been implemented yet."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SCRIPT DIRECTORY" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ScriptDirTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseScriptDir_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Step 1: Names" Style="{StaticResource LabelStyle}" Foreground="#888"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Export Names" Style="{StaticResource BrowseButton}" Margin="0,0,8,0" Click="ExportNames_Click"/>
                                <Button Content="Patch Names" Style="{StaticResource ActionButtonGreen}" Click="PatchNames_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Step 2: Dialogs" Style="{StaticResource LabelStyle}" Foreground="#888"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Export Dialog" Style="{StaticResource BrowseButton}" Margin="0,0,8,0" Click="ExportDialog_Click"/>
                                <Button Content="Patch Dialog" Style="{StaticResource ActionButtonGreen}" Click="PatchDialog_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Graphics Panel (hidden) -->
            <Border x:Name="PanelGfx" Background="{StaticResource BgDarkestBrush}" CornerRadius="0" Padding="20" BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="IMAGE FOLDER" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ImageFolderTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseImageFolder_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="MGF -> PNG" Style="{StaticResource BrowseButton}" Margin="0,0,8,0" Click="MgfToPng_Click"/>
                        <Button Content="PNG -> MGF" Style="{StaticResource ActionButtonGreen}" Click="PngToMgf_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
