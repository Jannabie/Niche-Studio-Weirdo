<UserControl x:Class="NicheStudioWeirdo.Views.AlicesoftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Alicesoft Engine" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Tools for Alicesoft games (.afa, .ald, .ain, .cg) using alice-tools" Style="{StaticResource SubheaderStyle}"/>

        <Border Grid.Row="2" Background="{StaticResource BgDarkestBrush}" CornerRadius="0" Padding="20" BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}">
            <StackPanel>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- EXTRACT ARCHIVE                                         -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <TextBlock Text="Extract Archive (.afa / .ald / .dat)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                <!-- Input archive file -->
                <TextBlock Text="Archive File (.afa / .ald / .dat):" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ExtractArchiveTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select archive file to extract (.afa, .ald, .dat)..."/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseExtractArchive_Click"/>
                </Grid>

                <!-- Output folder -->
                <TextBlock Text="Output Folder (where files will be extracted):" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ExtractOutputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select output folder (leave blank = auto-create next to archive)..."/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseExtractOutput_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
                    <Button Content="List Contents" Style="{StaticResource BrowseButton}" Margin="0,0,8,0" Click="ListArchive_Click" ToolTip="List files inside the selected archive"/>
                    <Button Content="Extract" Style="{StaticResource ActionButtonGreen}" Click="ExtractArchive_Click"/>
                </StackPanel>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- PACK AFA                                                -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border Background="#0A1A0A" CornerRadius="0" Padding="14,10" Margin="0,0,0,20"
                        BorderThickness="1" BorderBrush="#1E3A1E">
                    <StackPanel>
                        <TextBlock Foreground="#60C060" FontWeight="Bold" FontSize="12" Text="📖  PACK AFA ARCHIVE (.AFA ONLY)"/>
                        <TextBlock Foreground="#7A9A7A" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="alice-tools can only CREATE .afa archives. ALD is a read-only legacy format — you can extract it, but cannot repack to ALD. Workflow: Extract .ald → edit files → Pack as .afa."/>
                    </StackPanel>
                </Border>

                <!-- Input folder -->
                <TextBlock Text="Folder of Files to Pack:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PackInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select folder containing files to pack..."/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowsePackInput_Click"/>
                </Grid>

                <!-- Output AFA file -->
                <TextBlock Text="Output .afa File:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PackOutputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select output .afa file path (leave blank = auto-name in parent folder)..."/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowsePackOutput_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
                    <Button Content="Pack as AFA" Style="{StaticResource ActionButtonGreen}" Click="PackArchive_Click"/>
                </StackPanel>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                <!-- Script Tools (.ain) -->
                <TextBlock Text="Script Tools (.ain)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="AinFileTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select original .ain file..."/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseAin_Click"/>
                </Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="AinTxtTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select modified TXT file (for edit)..."/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseAinTxt_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                    <Button Content="Dump" Style="{StaticResource BrowseButton}" Margin="0,0,8,0" Click="DumpAin_Click"/>
                    <Button Content="Edit" Style="{StaticResource ActionButtonGreen}" Click="EditAin_Click"/>
                </StackPanel>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                <!-- Database Tools (.ex) -->
                <TextBlock Text="Database Tools (.ex)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ExFileTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select original .ex file..."/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseEx_Click"/>
                </Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ExTxtTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select modified TXT file (for edit)..."/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseExTxt_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                    <Button Content="Dump" Style="{StaticResource BrowseButton}" Margin="0,0,8,0" Click="DumpEx_Click"/>
                    <Button Content="Edit" Style="{StaticResource ActionButtonGreen}" Click="EditEx_Click"/>
                </StackPanel>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                <!-- Image Tools -->
                <TextBlock Text="Image Tools (.dcf / .qnt / .ajp)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                <!-- DCF note -->
                <Border Background="#100A1A" CornerRadius="0" Padding="12,10" Margin="0,0,0,8"
                        BorderThickness="1" BorderBrush="#2A1A3A">
                    <StackPanel>
                        <TextBlock Foreground="#A070D0" FontWeight="Bold" FontSize="11" Text="💡  ABOUT .DCF FORMAT"/>
                        <TextBlock Foreground="#8A7A9A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text=".dcf (Differential CG) is a sprite overlay/layer — not a full image. The resulting PNG contains character parts (eyes, hair, etc.) with transparent alpha, NOT a black background. This is correct. Viewers showing a dark background do not mean the conversion is wrong."/>
                    </StackPanel>
                </Border>

                <!-- Info banner -->
                <Border Background="#0A1020" CornerRadius="0" Padding="12,10" Margin="0,0,0,10"
                        BorderThickness="1" BorderBrush="#1E2A4A">
                    <StackPanel>
                        <TextBlock Foreground="#6080C0" FontWeight="Bold" FontSize="11" Text="🖼 SUPPORTED FORMATS"/>
                        <TextBlock Foreground="#7A8AAA" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="AliceSoft → PNG: alice-tools cg convert. All formats supported (.dcf, .qnt, .ajp, .cg).&#10;PNG → AliceSoft: copy file with the selected extension (the engine reads PNG natively)."/>
                    </StackPanel>
                </Border>

                <!-- ── SECTION A: AliceSoft → PNG ── -->
                <TextBlock Text="EXTRACT  —  AliceSoft → PNG" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Input File (.dcf / .qnt / .ajp):" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="CgFileTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select AliceSoft image file (.dcf, .qnt, .ajp)..."/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowseCg_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                    <Button Content="Extract → PNG" Style="{StaticResource ActionButtonGreen}" Click="ConvertCg_Click"
                            ToolTip="Convert AliceSoft image to PNG via alice-tools cg convert"/>
                </StackPanel>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>

                <!-- ── SECTION B: PNG → AliceSoft ── -->
                <TextBlock Text="REPACK  —  PNG → AliceSoft" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Input PNG File:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PngToAliceTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" Text="Select PNG file to repack..."/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BrowsePngToAlice_Click"/>
                </Grid>
                <TextBlock Text="Target Extension:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <ComboBox x:Name="CgTargetExtCombo"
                              Width="100" Margin="0,0,12,0"
                              SelectedIndex="0"
                              FontSize="12">
                        <ComboBoxItem Content=".dcf" Tag=".dcf"/>
                        <ComboBoxItem Content=".qnt" Tag=".qnt"/>
                        <ComboBoxItem Content=".ajp" Tag=".ajp"/>
                    </ComboBox>
                    <TextBlock Foreground="#505870" FontSize="10" VerticalAlignment="Center"
                               Text="Output filename will match the input PNG name with this extension."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Repack PNG → AliceSoft" Style="{StaticResource ActionButton}" Click="RepackPngToAlice_Click"
                            ToolTip="Copy PNG with the selected AliceSoft extension (no re-encoding)"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
