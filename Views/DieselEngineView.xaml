<UserControl x:Class="NicheStudioWeirdo.Views.DieselEngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Diesel Engine / Nitroplus (NPK)" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Extract and repack .npk archives using NPK3Tool for Nitroplus games like The Song of Saya." Style="{StaticResource SubheaderStyle}"/>

        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource BgDarkestBrush}" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}">
                <StackPanel>

                    <!-- GAME SELECTION -->
                    <TextBlock Text="TARGET GAME / PROFILE" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>
                    <ComboBox x:Name="GameProfileCombo" Margin="0,0,0,24" SelectedIndex="6">
                        <ComboBoxItem Content="0: You and Me and Her (Jast USA)"/>
                        <ComboBoxItem Content="1: You and Me and Her (Steam)"/>
                        <ComboBoxItem Content="2: Tokyo Necro"/>
                        <ComboBoxItem Content="3: Minikui Mojika no Ko"/>
                        <ComboBoxItem Content="4: SoniComi (JastUSA)"/>
                        <ComboBoxItem Content="5: The Song of Saya (Steam)"/>
                        <ComboBoxItem Content="6: The Song of Saya (Steam) [+18]"/>
                        <ComboBoxItem Content="7: Kishin Houkou Demonbane"/>
                        <ComboBoxItem Content="8: DRAMAtical Murder (Jast USA)"/>
                        <ComboBoxItem Content="9: DRAMAtical Murder (Steam)"/>
                        <ComboBoxItem Content="10: Full Metal Daemon Muramasa (Jast USA)"/>
                        <ComboBoxItem Content="11: Slow Damage (Jast USA)"/>
                        <ComboBoxItem Content="12: Tokyo Necro (Jast USA)"/>
                        <ComboBoxItem Content="13: sweet pool (Jast USA)"/>
                        <ComboBoxItem Content="14: sweet pool (Steam)"/>
                        <ComboBoxItem Content="15: Togainu no Chi –Lost Blood– (Jast USA)"/>
                        <ComboBoxItem Content="16: Togainu no Chi –Lost Blood– (Steam)"/>
                    </ComboBox>

                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>

                    <!-- EXTRACT -->
                    <TextBlock Text="EXTRACT  —  Archive.npk → Folder" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>

                    <TextBlock Text="INPUT .NPK" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ExtractInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseExtractInput_Click"/>
                    </Grid>

                    <TextBlock Text="OUTPUT DIRECTORY" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ExtractOutputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseExtractOutput_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FILE FILTER (optional, e.g: .nut or .nut,.json)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="FilterTxt" Style="{StaticResource TextBoxStyle}" ToolTip="Leave empty to extract all files. Enter extensions like .nut to only extract matching files — much faster!"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkSkipExisting" Grid.Column="2" Content="Skip already extracted files" VerticalAlignment="Bottom" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4" IsChecked="True"/>
                    </Grid>

                    <Button Content="Extract → Folder" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Right" Padding="20,8" Margin="0,0,0,28" Click="Extract_Click"/>

                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>

                    <!-- REPACK -->
                    <TextBlock Text="REPACK  —  Folder → Archive_new.npk" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>

                    <TextBlock Text="INPUT FOLDER (EXTRACTED FILES)" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RepackInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseRepackInput_Click"/>
                    </Grid>

                    <TextBlock Text="OUTPUT .NPK" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RepackOutputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseRepackOutput_Click"/>
                    </Grid>

                    <TextBlock Text="PACKING OPTIONS" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <CheckBox x:Name="ChkEnableSeg" Content="Enable Segmentation (-sg 1)" Foreground="{StaticResource TextLightBrush}" Margin="0,0,16,0"/>
                        <CheckBox x:Name="ChkForceSeg" Content="Force Segmentation (-fg 1)" Foreground="{StaticResource TextLightBrush}" IsChecked="True" Margin="0,0,16,0"/>
                        <CheckBox x:Name="ChkCompress" Content="Enable Compression (-cp 1)" Foreground="{StaticResource TextLightBrush}"/>
                    </StackPanel>

                    <Button Content="Repack → .NPK" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Right" Padding="20,8" Margin="0,0,0,24" Click="Repack_Click"/>

                    <!-- CNUT SCRIPT TRANSLATOR -->
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>
                    <TextBlock Text="CNUT SCRIPT TRANSLATOR (.nut)" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>
                    <TextBlock Text="Extract strings from compiled Squirrel bytecode (.nut) to JSON for translation, then inject back into the .nut file." Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <TextBlock Text="INPUT .NUT FILE" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="NutInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseNutInput_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Extract Text → .JSON" Style="{StaticResource ActionButtonGreen}" Padding="0,8" Click="ExtractNut_Click"/>
                        <Button Grid.Column="2" Content="Inject .JSON → .NUT" Style="{StaticResource ActionButtonGreen}" Padding="0,8" Click="InjectNut_Click"/>
                    </Grid>

                    <Border Background="#080808" CornerRadius="0" Padding="16,12" Margin="0,0,0,0" BorderThickness="1" BorderBrush="#222">
                        <StackPanel>
                            <TextBlock Foreground="#555" FontWeight="Bold" FontSize="11" Text="FULL WORKFLOW (from NPK to translated):"/>
                            <TextBlock Foreground="#444" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Text="① Extract NPK → use File Filter '.nut' to only get script files (much faster)"/>
                            <TextBlock Foreground="#444" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Text="② Select a .nut file above → click 'Extract Text → JSON'"/>
                            <TextBlock Foreground="#444" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Text="③ Edit the JSON: fill in the 'Translated' field for each string"/>
                            <TextBlock Foreground="#444" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Text="④ Click 'Inject JSON → NUT' to build the translated .nut file"/>
                            <TextBlock Foreground="#444" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Text="⑤ Replace the original .nut in the extracted folder, then Repack → NPK"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
