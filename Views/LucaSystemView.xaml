<UserControl x:Class="NicheStudioWeirdo.Views.LucaSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Luca System (Prototype)" Style="{StaticResource HeaderStyle}"/>
        <TextBlock Grid.Row="1" Text="Decompile SCRIPT.PAK and convert .CZ images for LucaSystem engine games." 
                   Style="{StaticResource SubheaderStyle}"/>

        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource BgDarkestBrush}" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}">
                <StackPanel>

                    <!-- Warning Banner -->
                    <Border Background="#0A1A0A" CornerRadius="0" Padding="14,10" Margin="0,0,0,24" BorderThickness="1" BorderBrush="#1E3A1E">
                        <StackPanel>
                            <TextBlock Foreground="#60C060" FontWeight="Bold" FontSize="12" Text="📖  IMPORTANT NOTE"/>
                            <TextBlock Text="The game profile is ONLY needed for SCRIPT decompile/compile (advanced). For CZ image convert, you can ignore this setting." 
                                       Foreground="#7A9A7A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- GAME PROFILE                                           -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <TextBlock Text="TARGET GAME / PROFILE" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextLightBrush}" FontSize="13" Margin="0,0,0,12"/>
                    <ComboBox x:Name="GameProfileCombo" Margin="0,0,0,8" SelectedIndex="0">
                        <ComboBoxItem Content="LOOPERS (Steam)"/>
                        <ComboBoxItem Content="LB_EN — Little Busters! English Edition (Steam)"/>
                        <ComboBoxItem Content="SP — Summer Pockets (Nintendo Switch)"/>
                        <ComboBoxItem Content="Cartagra HD (Japanese)"/>
                        <ComboBoxItem Content="Cartagra HD (English Steam)"/>
                        <ComboBoxItem Content="KANON (Steam)"/>
                        <ComboBoxItem Content="HARMONIA (Steam)"/>
                        <ComboBoxItem Content="LUNARiA (Steam)"/>
                        <ComboBoxItem Content="AIR (Steam)"/>
                        <ComboBoxItem Content="Planetarian SG (Steam)"/>
                    </ComboBox>

                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SCRIPT — DECOMPILE & IMPORT                            -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <TextBlock Text="SCRIPT TRANSLATION  —  SCRIPT.PAK ↔ Text Files" Style="{StaticResource LabelStyle}" Foreground="#599EAC" FontSize="13" Margin="0,0,0,12" FontWeight="Bold"/>
                    
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Decompile -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DECOMPILE  —  SCRIPT.PAK → Text" Style="{StaticResource LabelStyle}" Margin="0,0,0,8" Foreground="{StaticResource TextLightBrush}"/>
                            <TextBlock Text="INPUT SCRIPT.PAK" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ScriptDecompileInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" ToolTip="Select SCRIPT.PAK"/>
                                <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseScriptDecompileInput_Click"/>
                            </Grid>
                            
                            <TextBlock Text="💡 Output: Auto-saved to 'Script_Decompiled' folder" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Button Content="Decompile SCRIPT.PAK" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Right" Padding="16,7" Click="ScriptDecompile_Click"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush2}"/>

                        <!-- Import -->
                        <StackPanel Grid.Column="2" Margin="20,0,0,0">
                            <TextBlock Text="IMPORT  —  Text → New SCRIPT.PAK" Style="{StaticResource LabelStyle}" Margin="0,0,0,8" Foreground="{StaticResource TextLightBrush}"/>
                            <TextBlock Text="ORIGINAL SCRIPT.PAK" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ScriptImportSourceTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" ToolTip="The original unmodified SCRIPT.PAK"/>
                                <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseScriptImportSource_Click"/>
                            </Grid>
                            <TextBlock Text="MODIFIED TEXT FOLDER" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ScriptImportInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" ToolTip="Folder with your edited text files"/>
                                <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseScriptImportInput_Click"/>
                            </Grid>
                            
                            <TextBlock Text="💡 Output: Auto-saved as 'SCRIPT_NEW.PAK'" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Button Content="Import → New SCRIPT.PAK" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Right" Padding="16,7" Click="ScriptImport_Click"/>
                        </StackPanel>
                    </Grid>


                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- IMAGE — CZ → PNG                                       -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <TextBlock Text="IMAGE TRANSLATION  —  CZ Image ↔ PNG" Style="{StaticResource LabelStyle}" Foreground="#599EAC" FontSize="13" Margin="0,0,0,12" FontWeight="Bold"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Export CZ → PNG -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="EXPORT  —  CZ File → PNG" Style="{StaticResource LabelStyle}" Margin="0,0,0,8" Foreground="{StaticResource TextLightBrush}"/>
                            <TextBlock Text="INPUT CZ FILE" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="CzExportInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" ToolTip="Select a .CZ0/.CZ1/.CZ2/.CZ3 image file"/>
                                <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseCzExportInput_Click"/>
                            </Grid>
                            
                            <TextBlock Text="💡 Output: Auto-saved as a .png next to original" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Button Content="Export CZ → PNG" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Right" Padding="16,7" Click="CzExport_Click"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,0"/>

                        <!-- Import PNG → CZ -->
                        <StackPanel Grid.Column="2" Margin="20,0,0,0">
                            <TextBlock Text="IMPORT  —  PNG → CZ File" Style="{StaticResource LabelStyle}" Margin="0,0,0,8" Foreground="{StaticResource TextLightBrush}"/>
                            <TextBlock Text="ORIGINAL CZ FILE" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="CzImportSourceTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" ToolTip="Original CZ file to base the output format on"/>
                                <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseCzImportSource_Click"/>
                            </Grid>
                            <TextBlock Text="MODIFIED .PNG" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="CzImportInputTxt" Grid.Column="0" Style="{StaticResource TextBoxStyle}" ToolTip="Your edited PNG file"/>
                                <Button Grid.Column="1" Content="..." Style="{StaticResource BrowseButton}" Margin="5,0,0,0" Click="BrowseCzImportInput_Click"/>
                            </Grid>
                            
                            <TextBlock Text="💡 Output: Auto-saved as '_imported.czX'" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Button Content="Import PNG → CZ" Style="{StaticResource ActionButtonGreen}" HorizontalAlignment="Right" Padding="16,7" Click="CzImport_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Workflow Note -->
                    <Border Background="#080808" CornerRadius="0" Padding="16,12" Margin="0,0,0,0" BorderThickness="1" BorderBrush="#222">
                        <StackPanel>
                            <TextBlock Foreground="#555" FontWeight="Bold" FontSize="11" Text="FULL WORKFLOW (from PAK to translated/edited):"/>
                            <TextBlock Foreground="#444" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Text="① Select the correct Game Profile for your game above!"/>
                            <TextBlock Foreground="#444" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Text="② Script Decompile → point to SCRIPT.PAK and extract its scripts into editable text files"/>
                            <TextBlock Foreground="#444" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Text="③ Edit the extracted text files (pay attention to FULLWIDTH / ZENKAKU character limits!)"/>
                            <TextBlock Foreground="#444" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Text="④ Script Import → point to the original SCRIPT.PAK + your modified text folder → get a new SCRIPT.PAK"/>
                            <TextBlock Foreground="#444" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Text="⑤ Replace the original SCRIPT.PAK in your game directory with the new one."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
